---
import { Picture } from 'astro:assets';
import { resolveImage } from '../lib/images';
interface Props { src?: string | null; alt?: string | null; widths?: number[]; sizes?: string; loading?: 'lazy' | 'eager'; placeholder?: string; class?: string; fetchpriority?: 'high' | 'low' | 'auto' }
const { src, alt, widths = [480, 800, 1200, 1600], sizes = '(max-width: 860px) 100vw, 50vw', loading = 'lazy', placeholder = 'Photo coming soon', class: cls, fetchpriority } = Astro.props;
const image = resolveImage(src);
const usable = widths.filter((w) => !image || w <= image.width);
if (image && !usable.length) usable.push(image.width);
---
{image
  ? <Picture src={image} alt={alt ?? ''} widths={usable} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="jpg" loading={loading} decoding="async" class={cls} fetchpriority={fetchpriority} />
  : <div class={`placeholder ${cls ?? ''}`} role="img" aria-label={placeholder}>{placeholder}</div>}
