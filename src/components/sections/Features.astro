---
import Head from './Head.astro';
import { md } from '../../lib/content';
const { s } = Astro.props;
---
<section class="section">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    <div class="features">
      {s.items.map((i) => <div class="feature"><h3>{i.title}</h3><div set:html={md(i.text)} /></div>)}
    </div>
  </div>
</section>
