---
import Head from './Head.astro';
import { md, accent } from '../../lib/content';
const { s } = Astro.props;
---
<section class="chapter" data-tone="cream">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    <div class="features">
      {s.items.map((i) => <div class="feature"><h3 set:html={accent(i.title)} /><div set:html={md(i.text)} /></div>)}
    </div>
  </div>
</section>
