---
import Head from './Head.astro';
import Img from '../Img.astro';
import BookButton from '../BookButton.astro';
import { getActiveOffers, money, fmtDate } from '../../lib/content';
import { href } from '../../lib/url';
const { s } = Astro.props;
const offers = await getActiveOffers();
---
<section class="chapter" data-tone="cream">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    {offers.length ? (
      <div class="cards">
        {offers.map((o) => (
          <article class="post">
            {o.data.image && <div class="tile-media reveal"><Img src={o.data.image} alt={o.data.imageAlt} sizes="(max-width: 620px) 100vw, (max-width: 960px) 50vw, 33vw" /></div>}
            <h3>{o.data.title}</h3>
            <p>{o.data.summary}</p>
            {o.data.price != null && <span class="aside-price">{money(o.data.price)}</span>}
            {o.data.closedGroup && <p class="small">Available in the studio only, for returning clients.</p>}
            {o.data.validTo && <p class="small">Until {fmtDate(o.data.validTo)}.</p>}
            {o.data.terms && <p class="small">{o.data.terms}</p>}
            <div><BookButton serviceId={o.data.treatwellServiceId} label="Book this offer" size="small" placement="offers" /></div>
          </article>
        ))}
      </div>
    ) : (
      <p class="notice">There are no special offers at the moment. See our <a href={href('sugaring-prices-manchester#sugaring-packages')}>packages and courses</a>, including the Hollywood or Brazilian course of three.</p>
    )}
  </div>
</section>
