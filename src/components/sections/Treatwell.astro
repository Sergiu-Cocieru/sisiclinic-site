---
// Treatwell booking panel. The iframe loads only after a click: until then no Treatwell cookies or trackers reach this site.
import BookButton from '../BookButton.astro';
import { getSite, accent, md } from '../../lib/content';
const { s } = Astro.props;
const site = await getSite();
---
<section class="chapter dark" data-tone="deep">
  <div class="wrap">
    <div class="section-head">
      {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
      <h2 data-split set:html={accent(s.title ?? 'See free times and *book*')} />
      {s.intro && <div class="lede" set:html={md(s.intro)} />}
    </div>
    <div class="tw-panel" data-tw-panel data-src={site.treatwell.widgetUrl}>
      <div class="btn-row">
        <button type="button" class="btn btn-primary tw-load only-wide" data-tw-load>Show available times here</button>
        <BookButton label="See free times on Treatwell" class="only-narrow" placement="treatwell-panel" />
        <BookButton label="Open booking in a new tab" variant="ghost" class="only-wide" placement="treatwell-panel-tab" />
      </div>
      <p class="tw-note only-wide">Booking is handled by Treatwell. Showing it on this page loads Treatwell's booking system, which sets its own cookies.</p>
      <p class="tw-note only-narrow">Opens Treatwell in a new tab · no booking fee.</p>
      <div data-tw-slot></div>
    </div>
  </div>
</section>
<script>
  for (const panel of document.querySelectorAll<HTMLElement>('[data-tw-panel]')) {
    const btn = panel.querySelector<HTMLButtonElement>('[data-tw-load]');
    const slot = panel.querySelector<HTMLElement>('[data-tw-slot]');
    const src = panel.dataset.src!;
    btn?.addEventListener('click', () => {
      if (window.matchMedia('(max-width: 760px)').matches) { window.open(src, '_blank', 'noopener'); return; }
      const f = document.createElement('iframe');
      f.src = src; f.className = 'tw-frame'; f.title = 'Book with SISI Clinic on Treatwell'; f.loading = 'lazy';
      slot?.replaceChildren(f); btn.remove();
    });
  }
</script>
