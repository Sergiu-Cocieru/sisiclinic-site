---
import Head from './Head.astro';
import Img from '../Img.astro';
import { getServices, getPriceGroups, money } from '../../lib/content';
import { href } from '../../lib/url';
const { s } = Astro.props;
const services = await getServices();
const groups = await getPriceGroups();
const fromPrice = (ids: string[]) => {
  const prices = groups.filter((g) => ids.includes(g.id)).flatMap((g) => g.data.items.filter((i) => !i.free).map((i) => i.price));
  return prices.length ? Math.min(...prices) : undefined;
};
---
<section class="section">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    <div class="grid-3">
      {services.map((sv) => {
        const from = fromPrice(sv.data.priceGroups);
        return (
          <article class="card">
            <a class="card-media" href={href(sv.data.path)} tabindex="-1" aria-hidden="true"><Img src={sv.data.image} alt={sv.data.imageAlt} sizes="(max-width: 620px) 100vw, 33vw" /></a>
            <div class="card-body">
              <h3><a href={href(sv.data.path)} style="color:inherit;text-decoration:none">{sv.data.navLabel}</a></h3>
              <p>{sv.data.summary}</p>
              <div class="card-foot">
                {from !== undefined && <span class="from">from <b>{money(from)}</b></span>}
                <a class="link-arrow" href={href(sv.data.path)}>Details<span class="sr-only"> about {sv.data.navLabel}</span></a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
