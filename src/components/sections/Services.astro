---
import Head from './Head.astro';
import Img from '../Img.astro';
import Icon from '../Icon.astro';
import { getServices, getPriceGroups, money, md } from '../../lib/content';
import BookButton from '../BookButton.astro';
import { href } from '../../lib/url';
const { s } = Astro.props;
const services = await getServices();
const groups = await getPriceGroups();
const fromPrice = (ids: string[]) => {
  const prices = groups.filter((g) => ids.includes(g.id)).flatMap((g) => g.data.items.filter((i) => !i.free).map((i) => i.price));
  return prices.length ? Math.min(...prices) : undefined;
};
---
<section class="section">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    {(s.body || s.cta) && <div class="svc-intro">{s.body && <div class="prose" set:html={md(s.body)} />}{s.cta && <div><BookButton label={s.cta.label} placement="services" /></div>}</div>}
    <div class="svc-rail" data-rail>
      {services.map((sv, i) => {
        const from = sv.data.fromPrice ?? fromPrice(sv.data.priceGroups);
        // On phones and tablets the last card spans the full width when the count is odd
        const wideLast = i === services.length - 1 && services.length % 2 === 1;
        return (
          <a class="svc" href={href(sv.data.path)}>
            <div class="svc-media reveal"><Img src={sv.data.image} alt={sv.data.imageAlt} sizes={wideLast ? '(max-width: 860px) 100vw, 30vw' : '(max-width: 860px) 48vw, 30vw'} widths={[400, 800, 1200]} /></div>
            <div class="svc-over">
              <h3>{sv.data.navLabel}</h3>
              {from !== undefined && <span class="svc-from">from {money(from)}</span>}
            </div>
            <p class="svc-sum">{sv.data.summary}</p>
            <span class="svc-more">Details <Icon name="arrow" size={18} /></span>
          </a>
        );
      })}
    </div>
    <div class="rail-dots" data-dots aria-hidden="true"></div>
  </div>
</section>
