---
// Treatments as an editorial grid: five photos of different sizes, names under them, the whole tile is the link.
import Head from './Head.astro';
import Img from '../Img.astro';
import { getServices, getPriceGroups, money } from '../../lib/content';
import { href } from '../../lib/url';
const { s } = Astro.props;
const services = await getServices();
const groups = await getPriceGroups();
const fromPrice = (ids: string[]) => {
  const prices = groups.filter((g) => ids.includes(g.id)).flatMap((g) => g.data.items.filter((i) => !i.free).map((i) => i.price));
  return prices.length ? Math.min(...prices) : undefined;
};
const count = (ids: string[]) => groups.filter((g) => ids.includes(g.id)).reduce((n, g) => n + g.data.items.length, 0);
const sizes = ['(max-width: 860px) 100vw, 42vw', '(max-width: 860px) 50vw, 34vw', '(max-width: 860px) 50vw, 25vw', '(max-width: 860px) 50vw, 34vw', '(max-width: 860px) 50vw, 66vw'];
---
<section class="chapter" data-tone="cream">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    <div class="edit-grid">
      {services.map((sv, i) => {
        const from = sv.data.fromPrice ?? fromPrice(sv.data.priceGroups);
        const n = count(sv.data.priceGroups);
        const img = sv.data.cardImage ?? sv.data.image;
        return (
          <a class="tile" href={href(sv.data.path)}>
            <div class="tile-media reveal" style={img === sv.data.image ? `view-transition-name:svc-${sv.id}` : undefined}><Img src={img} alt={sv.data.imageAlt} sizes={sizes[i] ?? sizes[1]} widths={[480, 800, 1200]} /></div>
            <span class="tile-name">{sv.data.navLabel}</span>
            <span class="tile-meta caps">{from !== undefined && `From ${money(from)}`}{n > 0 && ` · ${n} ${n === 1 ? 'treatment' : 'treatments'}`}</span>
          </a>
        );
      })}
    </div>
  </div>
</section>
