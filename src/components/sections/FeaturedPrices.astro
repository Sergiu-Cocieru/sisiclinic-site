---
// Most-booked prices as a menu: the left column stays while the rows scroll; each row is one Treatwell link.
import Icon from '../Icon.astro';
import { getPriceGroups, getSite, money, md, accent } from '../../lib/content';
import { href, treatwellUrl } from '../../lib/url';
const { s } = Astro.props;
const site = await getSite();
const groups = await getPriceGroups();
const items = groups.flatMap((g) => g.data.items.filter((i) => i.featured).map((i) => ({ ...i, group: g.data.title, serviceId: g.data.treatwellServiceId })));
---
<section class="chapter" data-tone="cream">
  <div class="wrap menu-sec">
    <div class="menu-side">
      {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
      {s.title && <h2 data-split set:html={accent(s.title)} />}
      {s.intro && <div class="lede" set:html={md(s.intro)} />}
      {s.cta && <p><a class="text-link" href={href(s.cta.link)}>{s.cta.label}</a></p>}
    </div>
    <ul class="menu-rows">
      {items.map((i) => (
        <li>
          <a class="mrow" href={treatwellUrl(site.treatwell.widgetUrl, i.serviceId)} target="_blank" rel="noopener" data-book="featured-prices"
             aria-label={`Book ${i.name}, ${i.free ? 'free' : money(i.price)} (opens Treatwell booking in a new tab)`}>
            <span class="mrow-name">{i.name}<span class="mrow-meta caps">{i.minutes ? `${i.minutes} min` : ''}<span class="mrow-group">{i.minutes && i.group ? ' · ' : ''}{i.group}</span></span></span>
            <span class="mrow-price num">{i.free ? 'Free' : <>{i.from && <small>from</small>}{money(i.price)}</>}</span>
            <Icon name="arrow" size={18} class="mrow-go" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
