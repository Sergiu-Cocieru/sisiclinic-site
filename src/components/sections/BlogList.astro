---
import Head from './Head.astro';
import Img from '../Img.astro';
import { getPosts, fmtDate } from '../../lib/content';
import { href } from '../../lib/url';
const { s } = Astro.props;
const posts = await getPosts();
---
<section class="chapter" data-tone="cream">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    <div class="cards">
      {posts.map((p) => (
        <article class="post">
          <a class="tile-media reveal" href={href(p.data.path)} tabindex="-1" aria-hidden="true"><Img src={p.data.image} alt={p.data.imageAlt} sizes="(max-width: 620px) 100vw, (max-width: 960px) 50vw, 33vw" /></a>
          <div class="post-meta caps"><time datetime={p.data.date.toISOString()}>{fmtDate(p.data.updated ?? p.data.date)}</time></div>
          <h3><a href={href(p.data.path)}>{p.data.title}</a></h3>
          <p>{p.data.excerpt}</p>
          <a class="text-link" href={href(p.data.path)}>Read<span class="sr-only"> {p.data.title}</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
