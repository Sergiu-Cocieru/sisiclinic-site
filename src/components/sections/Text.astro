---
import Head from './Head.astro';
import { md } from '../../lib/content';
const { s } = Astro.props;
---
<section class="chapter" data-tone="cream">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    <div class="prose" set:html={md(s.body)} />
  </div>
</section>
