---
import Head from './Head.astro';
import { md } from '../../lib/content';
import { href } from '../../lib/url';
const { s } = Astro.props;
---
<section class="section tint">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    <ol class="steps">
      {s.items.map((i) => <li><h3>{i.title}</h3><div set:html={md(i.text)} /></li>)}
    </ol>
    {s.cta && <p style="margin-top:32px"><a class="btn btn-secondary" href={href(s.cta.link)}>{s.cta.label}</a></p>}
  </div>
</section>
