---
import Head from './Head.astro';
import Img from '../Img.astro';
const { s } = Astro.props;
---
<section class="section">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    <div class="grid-3">
      {s.images.map((g) => <div class="card-media" style="border-radius:var(--radius)"><Img src={g.image} alt={g.alt} sizes="(max-width: 620px) 100vw, 33vw" /></div>)}
    </div>
  </div>
</section>
