---
// The full price list set like a carte: a sticky index on desktop, hairline chips on phones, groups as menu rows.
import Head from './Head.astro';
import PriceRows from '../PriceRows.astro';
import { getPriceGroups, getSite, money, accent } from '../../lib/content';
import { treatwellUrl } from '../../lib/url';
const { s } = Astro.props;
const site = await getSite();
const all = await getPriceGroups();
const groups = s.groups?.length ? all.filter((g) => s.groups.includes(g.id)) : all;
const short: Record<string, string> = {
  'sugaring-packages': 'Packages', 'sugaring-body': 'Bikini & body', 'sugaring-face': 'Face', 'mens-sugaring-packages': "Men's packages",
  'mens-sugaring-body': "Men's body", 'mens-sugaring-face': "Men's face", 'laser-packages': 'Laser packages', 'laser-body': 'Laser body', 'laser-face': 'Laser face', consultation: 'Patch test',
};
const minOf = (g: any) => { const p = g.data.items.filter((i: any) => !i.free).map((i: any) => i.price); return p.length ? Math.min(...p) : 0; };
---
<section class="chapter" data-tone="cream">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    <div class="price-page" data-price-page>
      {groups.length > 2 && (
        <>
          <nav class="price-index" aria-label="Price groups">{groups.map((g) => <a href={`#${g.id}`} data-jump={g.id}>{short[g.id] ?? g.data.title}</a>)}</nav>
          <nav class="jump" aria-label="Price groups">{groups.map((g) => <a href={`#${g.id}`} data-jump={g.id}>{short[g.id] ?? g.data.title}</a>)}</nav>
        </>
      )}
      <div class="price-groups">
        {groups.map((g, i) => (
          <details class="pg" id={g.id} open={i < 2}>
            <summary>
              <span class="pg-title" set:html={accent(g.data.title)} />
              <span class="pg-meta caps">{minOf(g) ? `From ${money(minOf(g))}` : 'Free'} · {g.data.items.length} {g.data.items.length === 1 ? 'treatment' : 'treatments'}</span>
              <span class="plus" aria-hidden="true"></span>
            </summary>
            <div class="pg-body">
              <PriceRows group={g} placement="prices" />
              <div class="group-foot">
                {g.data.note ? <p class="price-note">{g.data.note}</p> : <span />}
                <a class="text-link" href={treatwellUrl(site.treatwell.widgetUrl, g.data.treatwellServiceId)} target="_blank" rel="noopener" data-book={`prices-${g.id}`}>Book {short[g.id]?.toLowerCase() ?? 'this group'} on Treatwell</a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
<script>
  // Desktop shows every group open; phones start with the first two. The index and the chips follow the scroll.
  const wide = window.matchMedia('(min-width: 861px)');
  const accs = [...document.querySelectorAll<HTMLDetailsElement>('.pg')];
  const sync = () => { if (wide.matches) accs.forEach((d) => (d.open = true)); };
  sync(); wide.addEventListener('change', sync);
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-jump]')];
  for (const a of links) a.addEventListener('click', () => { const d = document.getElementById(a.dataset.jump!) as HTMLDetailsElement | null; if (d) d.open = true; });
  if (links.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) {
        links.forEach((l) => l.removeAttribute('aria-current'));
        for (const l of links.filter((l) => l.dataset.jump === e.target.id)) {
          l.setAttribute('aria-current', 'true');
          const bar = l.parentElement!;
          if (bar.classList.contains('jump')) bar.scrollTo({ left: l.offsetLeft - (bar.clientWidth - l.offsetWidth) / 2, behavior: 'smooth' });
        }
      }
    }, { rootMargin: '-30% 0px -60% 0px' });
    accs.forEach((d) => io.observe(d));
  }
  if (location.hash) { const d = document.getElementById(location.hash.slice(1)) as HTMLDetailsElement | null; if (d?.tagName === 'DETAILS') d.open = true; }
</script>
