---
// Reviews are shown verbatim, most recent first (DMCC rules). The large slot skips comparative wording,
// because at display size a review reads as the studio's own claim; that review still appears in the rail.
import { getSite, getReviews, fmtDate, accent, leadReview } from '../../lib/content';
import { href } from '../../lib/url';
const { s } = Astro.props;
const site = await getSite();
const all = (await getReviews()).slice(0, s.limit ?? 6);
const lead = leadReview(all);
const rest = all.filter((r) => r !== lead);
---
<section class="chapter dark reviews" data-tone="deep">
  <div class="wrap reviews-body">
    <div class="rv-head">
      {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
      {s.title && <h2 data-split set:html={accent(s.title)} />}
      <p class="rating-caps caps">
        <span class="num">{site.treatwell.rating.toFixed(1)}</span><span class="stars" aria-hidden="true">★★★★★</span>
        <span>· {site.treatwell.reviewCount} reviews on Treatwell · {site.treatwell.asOf}</span>
        <a href={site.treatwell.widgetUrl} target="_blank" rel="noopener">Read them on Treatwell</a>
      </p>
    </div>
    {lead && (
      <figure class="rv-lead">
        <span class="quote-mark" aria-hidden="true">“</span>
        <blockquote>{lead.data.text}</blockquote>
        <figcaption class="caps">{lead.data.author} · {lead.data.source} review · {fmtDate(lead.data.date)}</figcaption>
      </figure>
    )}
    <div class="rv-rail" tabindex="0" role="region" aria-label="More client reviews">
      {rest.map((r) => (
        <figure class="rv-item">
          <span class="stars" aria-label={`${r.data.rating} out of 5`}>{'★'.repeat(r.data.rating)}</span>
          <blockquote>{r.data.text}</blockquote>
          <footer class="caps"><span>{r.data.author}</span><span>{r.data.source} review · {fmtDate(r.data.date)}</span></footer>
        </figure>
      ))}
    </div>
    <div class="rv-bar" aria-hidden="true"></div>
    <p class="small review-note">We show the most recent reviews, whatever the rating. <a href={href('review-policy')}>How we handle reviews</a>.</p>
  </div>
</section>
