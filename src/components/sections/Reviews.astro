---
import Head from './Head.astro';
import { getSite, getReviews, fmtDate } from '../../lib/content';
import { href } from '../../lib/url';
const { s } = Astro.props;
const site = await getSite();
const reviews = (await getReviews()).slice(0, s.limit ?? 6);
---
<section class="section tint">
  <div class="wrap">
    <Head eyebrow={s.eyebrow} title={s.title} intro={s.intro} />
    <div class="rating-line">
      <b class="num">{site.treatwell.rating.toFixed(1)}</b>
      <span class="stars" aria-hidden="true">★★★★★</span>
      <span>from {site.treatwell.reviewCount} reviews on Treatwell ({site.treatwell.asOf}). <a href={site.treatwell.widgetUrl} target="_blank" rel="noopener">Read them on Treatwell</a></span>
    </div>
    <div class="grid-3">
      {reviews.map((r) => (
        <figure class="review">
          <span class="stars" aria-label={`${r.data.rating} out of 5`}>{'★'.repeat(r.data.rating)}</span>
          <blockquote>{r.data.text}</blockquote>
          <footer><span>{r.data.author}</span><span>{r.data.source} review · {fmtDate(r.data.date)}</span></footer>
        </figure>
      ))}
    </div>
    <p class="small muted" style="margin-top:18px">We show the most recent reviews, whatever the rating. <a href={href('review-policy')}>How we handle reviews</a>.</p>
  </div>
</section>
