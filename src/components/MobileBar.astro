---
import { getSite } from '../lib/content';
const site = await getSite();
const wa = `https://wa.me/${site.whatsapp}`;
---
<div class="mobile-bar" role="navigation" aria-label="Quick actions">
  <a class="mb-book" href={site.treatwell.widgetUrl} target="_blank" rel="noopener" data-book="mobile-bar" aria-label="Book online (opens Treatwell booking in a new tab)">Book online</a>
  <a class="mb-alt" href={wa} target="_blank" rel="noopener" aria-label="Message us on WhatsApp (opens in a new tab)">WhatsApp</a>
  <a class="mb-alt" href={`tel:${site.phone}`}>Call</a>
</div>
