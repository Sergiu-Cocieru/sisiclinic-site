---
// Footer laid out like the original site: headline, quick links, opening hours, contact, social, legal
import Icon from './Icon.astro';
import { getSite, getHours } from '../lib/content';
import { href } from '../lib/url';
const site = await getSite();
const hours = await getHours();
const year = new Date().getFullYear();
const fmt = (t?: string | null) => { if (!t) return ''; const [h, m] = t.split(':').map(Number); const hh = h % 12 || 12; return `${hh}${m ? ':' + String(m).padStart(2, '0') : ''}${h < 12 ? 'am' : 'pm'}`; };
const quick = [['sugaring-hair-removal-manchester-clinic', 'About Us'], ['sugaring-hair-removal', 'Sugaring'], ['sugaring-prices-manchester', 'Pricing'], ['blog', 'Blog'], ['contact', 'Contact']];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-cta">
      <p>We are a click away from the results you've <em>always</em> dreamt of!</p>
      <a class="btn btn-primary" href={site.treatwell.widgetUrl} target="_blank" rel="noopener" data-book="footer">Book Now <span class="ext" aria-hidden="true">↗</span></a>
    </div>
    <div class="footer-grid">
      <div>
        <span class="footer-logo" aria-hidden="true"></span>
        <p>{site.tagline}.</p>
        <p class="langs">We speak English, Romanian and Russian · Vorbim română · Говорим по-русски</p>
      </div>
      <div>
        <h3>Quick Links</h3>
        <ul>{quick.map(([p, l]) => <li><a href={href(p)}>{l}</a></li>)}</ul>
      </div>
      <div class="footer-hours">
        <h3>Opening Hours</h3>
        <table class="hours">
          {hours.weekly.map((d) => <tr data-day={d.day}><td>{d.day.slice(0, 3)}</td><td>{d.closed ? 'Closed' : `${fmt(d.open)}–${fmt(d.close)}`}</td></tr>)}
        </table>
      </div>
      <div>
        <h3>Contact Information</h3>
        <ul>
          <li><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.mapsUrl} target="_blank" rel="noopener">{site.address.street}, {site.address.building}, {site.address.city}, {site.address.postcode}</a></li>
        </ul>
        <h3 style="margin-top:18px">Follow Us</h3>
        <div class="follow footer-follow">
          {site.social.facebook && <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={18} /></a>}
          {site.social.instagram && <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={18} /></a>}
          {site.social.tiktok && <a href={site.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Icon name="tiktok" size={18} /></a>}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>Copyright © {year} SISI CLINIC All Rights Reserved</span>
      <span><a href={href('terms-conditions')}>Terms of Service</a> · <a href={href('privacy-policy')}>Privacy Policy</a> · <a href={href('privacy-policy') + '#tracking-technologies-and-cookies'}>Cookie Policy</a></span>
    </div>
  </div>
</footer>
