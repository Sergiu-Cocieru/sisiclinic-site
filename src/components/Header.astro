---
import BookButton from './BookButton.astro';
import { href } from '../lib/url';
import { getSite } from '../lib/content';
const site = await getSite();
const current = Astro.url.pathname;
const nav = [
  ['sugaring-hair-removal', 'Sugaring'],
  ['laser-hair-removal', 'Laser'],
  ['sugaring-prices-manchester', 'Prices'],
  ['first-visit', 'First visit'],
  ['offer-sugaring-hair-removal-service', 'Offers'],
  ['sugaring-hair-removal-manchester-clinic', 'About'],
  ['blog', 'Blog'],
  ['contact', 'Contact'],
];
const ann = site.announcement;
---
{ann?.active && ann.text && (
  <div class="announce">{ann.link ? <a href={href(ann.link)}>{ann.text}</a> : ann.text}</div>
)}
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={href('')} aria-label="SISI Clinic home"><span class="brand-logo" aria-hidden="true"></span></a>
    <nav class="nav" aria-label="Main">
      {nav.map(([p, l]) => <a href={href(p)} aria-current={current.replace(/\/$/, '').endsWith('/' + p) ? 'page' : undefined}>{l}</a>)}
    </nav>
    <BookButton class="header-book" size="small" placement="header" />
    <details class="menu">
      <summary aria-label="Menu"><span></span></summary>
      <nav class="menu-panel" aria-label="Mobile">
        {nav.map(([p, l]) => <a href={href(p)}>{l}</a>)}
      </nav>
    </details>
  </div>
</header>
