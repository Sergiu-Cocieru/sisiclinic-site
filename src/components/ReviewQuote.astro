---
// One verbatim review, set large, for treatment pages: the newest one that carries no comparative claim.
import { getSite, getReviews, fmtDate, leadReview } from '../lib/content';
import { href } from '../lib/url';
const { service } = Astro.props;
const all = await getReviews();
const pool = service ? all.filter((r) => r.data.service === service) : [];
const lead = leadReview(pool.length ? pool : all);
const site = await getSite();
---
{lead && (
  <section class="chapter dark" data-tone="deep">
    <div class="wrap">
      <figure class="rv-lead" style="margin-bottom:0">
        <span class="quote-mark" aria-hidden="true">“</span>
        <blockquote>{lead.data.text}</blockquote>
        <figcaption class="caps">{lead.data.author} · {lead.data.source} review · {fmtDate(lead.data.date)} · <a href={href('review-policy')}>how we handle reviews</a> · <a href={site.treatwell.widgetUrl} target="_blank" rel="noopener">{site.treatwell.reviewCount} more on Treatwell</a></figcaption>
      </figure>
    </div>
  </section>
)}
