---
// A price group on a treatment page: title, "from" line, the rows, the note and one text link to book the group.
import PriceRows from './PriceRows.astro';
import { getSite, money, accent } from '../lib/content';
import { treatwellUrl } from '../lib/url';
const { group } = Astro.props;
const g = group.data;
const site = await getSite();
const prices = g.items.filter((i) => !i.free).map((i) => i.price);
const from = prices.length ? Math.min(...prices) : 0;
---
<div class="price-group" id={group.id}>
  <div class="group-head">
    <h3 set:html={accent(g.title)} />
    <span class="caps">{from ? `From ${money(from)}` : 'Free'} · {g.items.length} {g.items.length === 1 ? 'treatment' : 'treatments'}</span>
  </div>
  <PriceRows group={group} placement="service" />
  <div class="group-foot">
    {g.note ? <p class="price-note">{g.note}</p> : <span />}
    <a class="text-link" href={treatwellUrl(site.treatwell.widgetUrl, g.treatwellServiceId)} target="_blank" rel="noopener" data-book={`service-group-${group.id}`}>Book this group on Treatwell</a>
  </div>
</div>
