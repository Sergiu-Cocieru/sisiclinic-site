---
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource-variable/onest';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { getSite, getHours } from '../lib/content';
import { resolveImage } from '../lib/images';
import { isPreview } from '../lib/url';
import logo from '../assets/uploads/logo-sisi-black.png';

interface Props {
  title: string;            // full <title>
  description: string;
  path: string;             // '' for home, 'contact', 'sugaring-hair-removal/face'
  image?: string;           // /src/assets/uploads/...
  noindex?: boolean;
  schema?: object[];        // extra JSON-LD nodes for this page
  breadcrumbs?: { name: string; path: string }[];
}
const { title, description, path, image, noindex = false, schema = [], breadcrumbs = [] } = Astro.props;
const PROD = 'https://sisiclinic.co.uk';
const site = await getSite();
const hours = await getHours();
const canonical = `${PROD}/${path ? path + '/' : ''}`;
const ogSource = resolveImage(image ?? site.seo.image);
const og = ogSource ? await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : undefined;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;
const logoImg = await getImage({ src: logo, width: 600, format: 'png' });
const robots = isPreview || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

const dayMap: Record<string, string> = { Monday: 'Mo', Tuesday: 'Tu', Wednesday: 'We', Thursday: 'Th', Friday: 'Fr', Saturday: 'Sa', Sunday: 'Su' };
const salon = {
  '@type': 'BeautySalon',
  '@id': `${PROD}/#salon`,
  name: site.name,
  url: `${PROD}/`,
  description: site.description,
  telephone: site.phone,
  email: site.email,
  image: ogUrl,
  logo: new URL(logoImg.src, Astro.site).href,
  priceRange: '£10–£249',
  address: { '@type': 'PostalAddress', streetAddress: `${site.address.building}, ${site.address.street}`, addressLocality: site.address.city, postalCode: site.address.postcode, addressCountry: 'GB' },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: hours.weekly.filter((d) => !d.closed).map((d) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: `https://schema.org/${d.day}`, opens: d.open, closes: d.close })),
  knowsLanguage: site.languages,
  areaServed: 'Manchester',
  sameAs: [site.social.instagram, site.social.facebook, site.social.tiktok].filter(Boolean),
};
const graph: object[] = [salon, { '@type': 'WebSite', '@id': `${PROD}/#website`, url: `${PROD}/`, name: site.name, publisher: { '@id': `${PROD}/#salon` } }, ...schema];
if (breadcrumbs.length) {
  graph.push({ '@type': 'BreadcrumbList', itemListElement: [{ name: 'Home', path: '' }, ...breadcrumbs].map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: `${PROD}/${b.path ? b.path + '/' : ''}` })) });
}
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="SISI Clinic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FAF2E9" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <script type="application/ld+json" set:html={jsonld} />
  </head>
  <body style={`--logo: url(${logoImg.src})`}>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
  </body>
</html>
