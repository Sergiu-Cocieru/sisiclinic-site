---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sections from '../components/Sections.astro';
import PageHead from '../components/PageHead.astro';
import Img from '../components/Img.astro';
import BookButton from '../components/BookButton.astro';
import PriceGroup from '../components/PriceGroup.astro';
import ReviewQuote from '../components/ReviewQuote.astro';
import Steps from '../components/sections/Steps.astro';
import Faq from '../components/sections/Faq.astro';
import BookingBand from '../components/sections/BookingBand.astro';
import { getPriceGroups, getServices, getSite, fmtDate, md, money, accent, minPrice, waLink } from '../lib/content';
import { href } from '../lib/url';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const services = await getCollection('services');
  const posts = await getCollection('blog', (p) => !p.data.draft);
  const all = [
    ...pages.map((e) => ({ kind: 'page', path: e.data.path, entry: e })),
    ...services.map((e) => ({ kind: 'service', path: e.data.path, entry: e })),
    ...posts.map((e) => ({ kind: 'post', path: e.data.path, entry: e })),
  ];
  const seen = new Map();
  for (const r of all) {
    if (seen.has(r.path)) throw new Error(`Two entries use the same address "/${r.path}/": ${seen.get(r.path)} and ${r.entry.id}`);
    seen.set(r.path, r.entry.id);
  }
  return all.map((r) => ({ params: { path: r.path || undefined }, props: r }));
}

const { kind, path, entry } = Astro.props as any;
const site = await getSite();
const d = entry.data;
const nice = (t: string) => `${t.replace(/\*/g, '')} | SISI Clinic Manchester`;

let title = '', description = '', image: string | undefined, preload: string | undefined, crumbs: { name: string; path: string }[] = [], schema: object[] = [];
let Content: any = null;
if (kind === 'page') {
  title = d.seo?.title ?? (path === '' ? site.seo.title : nice(d.title));
  description = d.seo?.description ?? site.seo.description;
  image = d.seo?.image;
  if (path) crumbs = [{ name: d.title, path }];
  Content = (await render(entry)).Content;
  const first = d.sections?.[0];
  if (first?.type === 'hero' && first.image) preload = first.image;
}
let service: any = null;
if (kind === 'service') {
  title = d.seo?.title ?? nice(d.title);
  description = d.seo?.description ?? d.summary;
  image = d.image;
  preload = d.image;
  crumbs = path.startsWith('sugaring-hair-removal/') ? [{ name: 'Sugaring', path: 'sugaring-hair-removal' }, { name: d.navLabel, path }] : [{ name: d.navLabel, path }];
  const groups = (await getPriceGroups()).filter((g) => d.priceGroups.includes(g.id));
  const services = await getServices();
  const related = await Promise.all(services.filter((s) => s.id !== entry.id).slice(0, 3).map(async (r) => ({ r, from: r.data.fromPrice ?? (await minPrice(r.data.priceGroups)) })));
  const minutes = groups.flatMap((g) => g.data.items.map((i) => i.minutes).filter((m): m is number => !!m));
  service = { groups, related, count: groups.reduce((n, g) => n + g.data.items.length, 0), from: d.fromPrice ?? (await minPrice(d.priceGroups)), minutes: minutes.length ? Math.min(...minutes) : undefined, wa: waLink(site.whatsapp, `Hi SISI, I'm thinking about booking ${d.navLabel}.`) };
  Content = (await render(entry)).Content;
  schema.push({
    '@type': 'Service', name: d.title.replace(/\*/g, ''), description: d.summary, provider: { '@id': 'https://sisiclinic.co.uk/#salon' }, areaServed: 'Manchester',
    hasOfferCatalog: { '@type': 'OfferCatalog', name: `${d.navLabel} prices`, itemListElement: groups.flatMap((g) => g.data.items.map((i) => ({ '@type': 'Offer', name: i.name, price: i.free ? 0 : i.price, priceCurrency: 'GBP' }))) },
  });
}
if (kind === 'post') {
  title = d.seo?.title ?? nice(d.title);
  description = d.seo?.description ?? d.excerpt;
  image = d.image;
  preload = d.image;
  crumbs = [{ name: 'Blog', path: 'blog' }, { name: d.title, path }];
  Content = (await render(entry)).Content;
  schema.push({ '@type': 'BlogPosting', headline: d.title, datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(), author: d.author ? { '@type': 'Person', name: d.author } : { '@id': 'https://sisiclinic.co.uk/#salon' }, publisher: { '@id': 'https://sisiclinic.co.uk/#salon' }, mainEntityOfPage: `https://sisiclinic.co.uk/${path}/` });
}
const firstIsHero = kind === 'page' && d.sections?.[0]?.type === 'hero';
---
<Base title={title} description={description} path={path} image={image} noindex={d.seo?.noindex} schema={schema} breadcrumbs={crumbs} preloadImage={preload}>
  {kind === 'page' && (
    <>
      {!firstIsHero && <PageHead title={d.title} crumbs={crumbs} />}
      {entry.body?.trim() && <div class="wrap"><div class="prose" style="padding-bottom:var(--chapter)"><Content /></div></div>}
      <Sections sections={d.sections} />
    </>
  )}

  {kind === 'service' && (
    <>
      <section class="svc-hero chapter" data-tone="cream">
        <div class="bleed">
          <div class="svc-hero-copy">
            <nav class="crumbs" aria-label="Breadcrumb"><a href={href('')}>Home</a>{crumbs.slice(0, -1).map((c) => <> / <a href={href(c.path)}>{c.name}</a></>)} / <span aria-current="page">{d.navLabel}</span></nav>
            <h1 data-split set:html={accent(d.title)} />
            <p class="lede">{d.summary}</p>
            <div class="stats caps">
              {service.from !== undefined && <div><b class="num">{money(service.from)}</b><span>from</span></div>}
              {service.count > 0 && <div><b class="num">{service.count}</b><span>{service.count === 1 ? 'treatment' : 'treatments'}</span></div>}
              <div><b>Private</b><span>room, door closed</span></div>
            </div>
            <div class="btn-row" data-hero-cta>
              <BookButton serviceId={d.treatwellServiceId} placement={`service-${entry.id}`} />
              {service.groups.length > 0 && <a class="text-link" href="#prices">See prices</a>}
            </div>
          </div>
          <div class="svc-hero-media"><div class="svc-hero-photo" style={`view-transition-name:svc-${entry.id}`}><Img src={d.image} alt={d.imageAlt} loading="eager" fetchpriority="high" sizes="(max-width: 860px) 100vw, 40vw" widths={[800, 1200, 1600]} /></div></div>
        </div>
      </section>
      <section class="chapter" data-tone="cream" style="padding-top:0">
        <div class="wrap svc-body">
          <div class="prose"><Content /></div>
          <aside class="aside">
            {d.whoFor && <div class="aside-block"><span class="eyebrow">Who it's for</span><div class="prose" set:html={md(d.whoFor)} /></div>}
            <div class="aside-block">
              <span class="eyebrow">Book this treatment</span>
              {service.from !== undefined && <span class="aside-price"><small>from</small>{money(service.from)}</span>}
              <div class="btn-row"><BookButton serviceId={d.treatwellServiceId} placement={`service-aside-${entry.id}`} /></div>
              <a class="text-link" href={service.wa} target="_blank" rel="noopener">Ask on WhatsApp first</a>
            </div>
          </aside>
        </div>
      </section>
      {d.steps.length > 0 && <Steps s={{ eyebrow: 'Your appointment', title: 'What happens, step by *step*', items: d.steps }} />}
      {(d.feel || d.prep.length || d.aftercare.length) && (
        <section class="chapter" data-tone="cream">
          <div class="wrap feel-grid">
            {d.feel && <div class="feel-col"><h3>How it <em>feels</em></h3><div set:html={md(d.feel)} /></div>}
            {d.prep.length > 0 && <div class="feel-col"><h3>Before you <em>come</em></h3><ul>{d.prep.map((x) => <li>{x}</li>)}</ul></div>}
            {d.aftercare.length > 0 && <div class="feel-col"><h3>After<em>wards</em></h3><ul>{d.aftercare.map((x) => <li>{x}</li>)}</ul></div>}
          </div>
        </section>
      )}
      <ReviewQuote service={d.faqCategory === 'laser' ? 'Laser' : 'Sugaring'} />
      {service.groups.length > 0 && (
        <section class="chapter" data-tone="cream" id="prices">
          <div class="wrap">
            <div class="section-head row"><span class="eyebrow">Prices</span><h2 data-split set:html={accent(`${d.navLabel} *prices*`)} /><div class="lede"><p>The same prices as on Treatwell. Book online, or ask us on WhatsApp first.</p></div></div>
            {service.groups.map((g: any) => <PriceGroup group={g} />)}
            <p style="margin-top:28px"><a class="text-link" href={href('sugaring-prices-manchester')}>All prices</a></p>
          </div>
        </section>
      )}
      {d.faqCategory && <Faq s={{ eyebrow: 'Questions', title: 'Questions we often *hear*', category: d.faqCategory, limit: 6 }} />}
      <section class="chapter" data-tone="cream">
        <div class="wrap">
          <div class="section-head"><span class="eyebrow">Also at SISI</span><h2 data-split set:html={accent('Related *treatments*')} /></div>
          <div class="related">
            {service.related.map(({ r, from }: any, i: number) => (
              <a class="tile" href={href(r.data.path)}>
                <div class="tile-media reveal"><Img src={r.data.cardImage ?? r.data.image} alt={r.data.imageAlt} sizes={i === 2 ? "(max-width: 960px) 100vw, 30vw" : "(max-width: 860px) 50vw, (max-width: 960px) 100vw, 30vw"} widths={[480, 800, 1200]} /></div>
                <span class="tile-name">{r.data.navLabel}</span>
                {from !== undefined && <span class="tile-meta caps">From {money(from)}</span>}
              </a>
            ))}
          </div>
        </div>
      </section>
      <BookingBand s={{ title: 'Book your *appointment*', intro: 'Choose a time online in a minute, or message us on WhatsApp if you have a question first.', whatsappText: `Hi SISI, I'm thinking about booking ${d.navLabel}.` }} />
    </>
  )}

  {kind === 'post' && (
    <article>
      <div class="wrap narrow article-hero">
        <nav class="crumbs" aria-label="Breadcrumb"><a href={href('')}>Home</a> / <a href={href('blog')}>Blog</a></nav>
        <h1 data-split set:html={accent(d.title)} />
        <div class="post-meta caps"><time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>{d.updated && <span>Updated {fmtDate(d.updated)}</span>}{d.author && <span>By {d.author}</span>}</div>
      </div>
      <div class="wrap narrow">
        <div class="article-cover"><Img src={d.image} alt={d.imageAlt} loading="eager" fetchpriority="high" sizes="(max-width: 800px) 100vw, 760px" /></div>
        <div class="prose" style="padding-bottom:var(--chapter)"><Content /></div>
      </div>
      <BookingBand s={{ title: 'Ready to try *sugaring*?', intro: 'Book online in a minute, or message us on WhatsApp with any question.' }} />
    </article>
  )}
</Base>
